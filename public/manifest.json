{
  "manifest_version": 3,

  "name": "Currency Calculator",
  "description": "Currency Calculator",
  "version": "0.0.1",

  "options_page": "options.html",

  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "180": "icon180.png",
    "192": "icon192.png",
    "512": "icon512.png"
  },

  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content_script.js"],
      "run_at": "document_end"
    }
  ],

  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],

  "web_accessible_resources": [
    {
      "resources": [
        "options.html",
        "icon16.png",
        "icon32.png",
        "icon48.png",
        "icon180.png",
        "icon192.png",
        "icon512.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
